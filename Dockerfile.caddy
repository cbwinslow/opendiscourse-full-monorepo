# Multi-stage Dockerfile for custom Caddy server

# Stage 1: Build custom Caddy with plugins
FROM golang:1.21-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Set working directory
WORKDIR /build

# Copy Go module files
COPY go.mod go.sum ./
RUN go mod download

# Copy Caddy builder
COPY caddy-builder.go ./

# Build custom Caddy binary
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -extldflags '-static'" \
    -a -installsuffix cgo \
    -o caddy \
    caddy-builder.go

# Stage 2: Create runtime image
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    curl \
    tzdata \
    mailcap

# Create caddy user
RUN addgroup -g 1000 caddy && \
    adduser -D -s /bin/sh -u 1000 -G caddy caddy

# Create necessary directories
RUN mkdir -p /etc/caddy /usr/share/caddy /var/log/caddy /data /config && \
    chown -R caddy:caddy /etc/caddy /usr/share/caddy /var/log/caddy /data /config

# Copy custom Caddy binary
COPY --from=builder /build/caddy /usr/bin/caddy

# Copy default configuration
COPY Caddyfile /etc/caddy/Caddyfile

# Copy web assets
COPY web/ /srv/web/
COPY docs/ /srv/docs/

# Set permissions
RUN chmod +x /usr/bin/caddy

# Create a basic index.html
RUN echo '<!DOCTYPE html><html><head><title>OpenDiscourse</title></head><body><h1>OpenDiscourse Development Server</h1><p>Powered by Caddy</p></body></html>' > /usr/share/caddy/index.html

# Switch to caddy user
USER caddy

# Expose ports
EXPOSE 80 443 8080 8081 9090

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Default command
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
