# OpenDiscourse Development Server Configuration
# This Caddyfile configures Caddy for local development

# Global options
{
	# Enable debug mode for development
	debug
	
	# Disable admin API for security in development
	admin off
	
	# Enable experimental HTTP/3
	servers {
		protocol {
			experimental_http3
		}
	}
	
	# Custom log format for development
	log {
		output stdout
		format console
		level DEBUG
	}
}

# Main development server
localhost:8080 {
	# Enable detailed logging for this site
	log {
		output file logs/access.log {
			roll_size 10MB
			roll_keep 5
		}
		format json
	}

	# Security headers for development
	header {
		# CORS headers for API access
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
		Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
		Access-Control-Max-Age "86400"
		
		# Security headers
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		
		# Development headers
		X-Dev-Server "Caddy-OpenDiscourse"
		X-Served-By "Caddy/2.7"
	}

	# Handle preflight OPTIONS requests
	@options {
		method OPTIONS
	}
	respond @options 204

	# API Routes - Proxy to FastAPI backend
	handle_path /api/* {
		reverse_proxy localhost:8000 {
			# Health check
			health_uri /health
			health_interval 30s
			health_timeout 5s
			
			# Request modifications
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			
			# Response modifications
			header_down -Server
		}
	}

	# Handle direct API routes (without /api prefix)
	handle_path /v1/* {
		reverse_proxy localhost:8000 {
			health_uri /health
			health_interval 30s
			health_timeout 5s
		}
	}

	# Health check endpoint
	handle /health {
		respond "OK" 200
	}

	# WebSocket support for live reloading
	handle /ws {
		reverse_proxy localhost:8001 {
			header_up Upgrade {http.request.header.upgrade}
			header_up Connection {http.request.header.connection}
		}
	}

	# Development tools and monitoring
	handle /caddy/* {
		basicauth {
			admin $2a$14$hgl3U0dmlmyX.NpXwGPjqOLgMXkH.qVzZcGnhpCB5kkbCz5O1.X6e
		}
		file_server browse
		root * ./monitoring
	}

	# Static assets with caching
	handle /static/* {
		file_server
		root * ./web/static
		
		# Cache static assets
		header Cache-Control "public, max-age=3600"
		
		# Compression
		encode gzip zstd
	}

	# Serve web interface files
	handle /web/* {
		file_server
		root * ./
		
		# Try files in order
		try_files {path} {path}/index.html /web/navigation.html
		
		# No cache for development
		header Cache-Control "no-cache, no-store, must-revalidate"
		header Pragma "no-cache"
		header Expires "0"
	}

	# Documentation serving
	handle /docs/* {
		file_server browse
		root * ./docs
		
		# Markdown rendering (if plugin available)
		templates
		
		header Cache-Control "public, max-age=1800"
		encode gzip
	}

	# Default route - serve main navigation
	handle {
		rewrite * /web/navigation.html
		file_server
		root * ./
	}

	# Error handling
	handle_errors {
		@404 {
			expression {http.error.status_code} == 404
		}
		rewrite @404 /web/navigation.html
		file_server
		root * ./
	}
}

# API-only server (for direct API access)
localhost:8000 {
	log {
		output file logs/api.log
		format json
	}
	
	# Reverse proxy to FastAPI
	reverse_proxy localhost:8000 {
		# Load balancing (for multiple instances)
		lb_policy round_robin
		
		# Health checks
		health_uri /health
		health_interval 10s
		health_timeout 3s
		
		# Retry policy
		try_duration 30s
		try_interval 2s
	}
}

# Metrics and monitoring server
localhost:9090 {
	log {
		output file logs/metrics.log
	}
	
	# Basic auth for metrics
	basicauth {
		admin $2a$14$hgl3U0dmlmyX.NpXwGPjqOLgMXkH.qVzZcGnhpCB5kkbCz5O1.X6e
	}
	
	# Metrics endpoint
	handle /metrics {
		respond "# Caddy metrics placeholder" 200
	}
	
	# Status page
	handle /status {
		templates
		file_server
		root * ./monitoring
	}
	
	# Default metrics dashboard
	handle {
		file_server browse
		root * ./monitoring
	}
}

# Development file server (for serving raw files)
localhost:8081 {
	log {
		output file logs/files.log
	}
	
	# File browser for development
	file_server browse {
		hide .git .env* *.pyc __pycache__ .pytest_cache
	}
	
	# Template rendering for markdown files
	templates {
		mime_types text/markdown
	}
	
	# Compression for text files
	encode gzip zstd {
		match {
			header Content-Type text/*
			header Content-Type application/json
			header Content-Type application/javascript
			header Content-Type application/xml
		}
	}
}

# Import additional configurations
import sites/*.caddy
