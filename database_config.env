# OpenDiscourse Database Configuration
# Database connection details for data ingestion workflows

# PostgreSQL Database Configuration
DB_HOST=172.28.82.205
DB_PORT=5432
DB_NAME=opendiscourse
DB_USER=opendiscourse
DB_PASSWORD=opendiscourse123

# Database Connection URL
DATABASE_URL=postgresql://opendiscourse:opendiscourse123@172.28.82.205:5432/opendiscourse

# API Keys (placeholders - replace with actual keys)
OPENSTATES_API_KEY=your_openstates_api_key_here
CONGRESS_API_KEY=your_congress_api_key_here
GOVINFO_API_KEY=your_govinfo_api_key_here

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Ingestion Settings
BATCH_SIZE=50
MAX_RETRIES=3
RETRY_DELAY=5

# Data Source Settings
OPENSTATES_BASE_URL=https://openstates.org/api/v1
CONGRESS_BASE_URL=https://api.congress.gov/v3
GOVINFO_BASE_URL=https://www.govinfo.gov/bulkdata