{
  "name": "opendiscourse-monorepo",
  "version": "1.0.0",
  "description": "OpenDiscourse Monorepo - A platform for analyzing government documents and political discourse",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter \"./packages/*\" --filter \"./apps/*\" run dev",
    "build": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" run build",
    "test": "pnpm --recursive run test",
    "lint": "pnpm --recursive run lint",
    "clean": "rm -rf node_modules && pnpm --recursive exec rm -rf node_modules",
    "format": "prettier --write ."
  },
  "keywords": [
    "opendiscourse",
    "government-data",
    "document-analysis",
    "political-discourse",
    "nlp",
    "rag",
    "vector-database"
  ],
  "author": "OpenDiscourse Contributors",
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}